# ─────────────────────────────────────────────
#  Copy this file to .env and fill in values
#  cp .env.example .env
# ─────────────────────────────────────────────

# ── Server ────────────────────────────────────
PORT=5055
DEBUG=False

# ── Security ─────────────────────────────────
# Generate a strong random key:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-a-long-random-string

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5055,http://127.0.0.1:5055

# Maximum accepted POST body size in bytes (default 65536 = 64 KB)
MAX_REQUEST_BYTES=65536

# ── Ollama ────────────────────────────────────
# URL of your local Ollama instance
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Default model to use (must also appear in ALLOWED_MODELS)
# qwen2.5:14b is recommended for 24GB GPUs (100% VRAM offload, ~38-40 t/s)
OLLAMA_MODEL=qwen2.5:14b

# Comma-separated allowlist of safe model names
ALLOWED_MODELS=qwen2.5:32b,qwen2.5:14b,qwen2.5:latest,qwen2.5:0.5b,qwen3:30b,qwen3:14b,qwen3:8b,gpt-oss:20b,llama3.1:latest,llama3:latest

# Timeout in seconds for Ollama requests
OLLAMA_TIMEOUT=60
OLLAMA_CONNECT_TIMEOUT=2.5
OLLAMA_READ_TIMEOUT=30
OLLAMA_MAX_RETRIES=1

# Model keep-alive duration (e.g. 10m, 1h, 24h)
OLLAMA_KEEP_ALIVE=24h

# Context window size (tokens)
OLLAMA_NUM_CTX=2048

# Generation temperature (0.0 = fully deterministic)
OLLAMA_TEMPERATURE=0.0
OLLAMA_TOP_P=0.8
